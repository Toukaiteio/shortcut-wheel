<Window x:Class="ShortcutWheel.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShortcutWheel.Controls"
        xmlns:local="clr-namespace:ShortcutWheel.ViewModels"
        xmlns:l="clr-namespace:ShortcutWheel.Services"
        Title="{DynamicResource AppTitle}"
        Height="640" Width="900"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#1A1612"
        Foreground="#F2ECDD"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ============================ Brushes ============================ -->
        <SolidColorBrush x:Key="Bg.Page" Color="#B01A1612" />
        <SolidColorBrush x:Key="Bg.Panel" Color="#CC241E18" />
        <SolidColorBrush x:Key="Bg.Input" Color="#CC15110D" />
        <SolidColorBrush x:Key="Bg.Hover" Color="#CC3A2F22" />
        <SolidColorBrush x:Key="Bg.Selected" Color="#CC5C4528" />
        <SolidColorBrush x:Key="Border.Subtle" Color="#3A332A" />
        <SolidColorBrush x:Key="Trim.Gold" Color="#C9A24E" />
        <SolidColorBrush x:Key="Trim.GoldDim" Color="#7A6A48" />
        <SolidColorBrush x:Key="Text.Primary" Color="#F2ECDD" />
        <SolidColorBrush x:Key="Text.Secondary" Color="#9A8E78" />

        <!-- ============================ ScrollBar ========================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="0" Height="0" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ TextBlock =========================== -->
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Trim.Gold}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- ============================ Button ============================== -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Trim.GoldDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Trim.Gold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A3826" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GoldButton}">
            <Setter Property="Background" Value="{StaticResource Trim.Gold}" />
            <Setter Property="Foreground" Value="#1A1612" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource GoldButton}" />

        <!-- ============================ TextBox ============================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Bg.Input}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="{StaticResource Trim.Gold}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Trim.GoldDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Trim.Gold}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Trim.GoldDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ CheckBox =========================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ============================ Slider ============================= -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Trim.Gold}" />
        </Style>

        <!-- ============================ ComboBox =========================== -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Bg.Input}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Trim.Gold}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Selected}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{StaticResource Bg.Input}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{StaticResource Trim.Gold}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Trim.GoldDim}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Trim.Gold}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Bg.Input}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Trim.GoldDim}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ TabControl ========================= -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="Underline"
                                        Height="3"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource Trim.Gold}"
                                        Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Panel}" />
                                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Trim.Gold}" />
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ TreeView =========================== -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="{StaticResource Bg.Input}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="3,4" />
        </Style>

        <!-- ============================ StatusBar ========================== -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource Bg.Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- ============================ Separator ========================== -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource Border.Subtle}" />
            <Setter Property="Margin" Value="0,12" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg.Page}" Padding="0">
        <!-- Background image layer (behind all content) -->
        <Grid>
            <Image x:Name="ConfigBgImage"
                   Stretch="UniformToFill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Bg.Panel}" Padding="20,14"
                    BorderBrush="{StaticResource Trim.Gold}" BorderThickness="0,0,0,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="★" Foreground="{StaticResource Trim.Gold}" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource AppHeader}" Foreground="{StaticResource Trim.Gold}"
                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="{StaticResource Text.Secondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0" />
                </StackPanel>
            </Border>

            <TabControl Grid.Row="1" Margin="0">
                <TabItem Header="{DynamicResource TabShortcuts}">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <!-- Shortcut tree -->
                        <Border Background="{StaticResource Bg.Panel}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="10,10,10,8">
                                    <Button x:Name="BtnAddFile" Content="{DynamicResource BtnAddFile}" Margin="0,0,8,0"
                                            Click="BtnAddFile_Click" />
                                    <Button x:Name="BtnAddFolder" Content="{DynamicResource BtnAddFolder}" Margin="0,0,8,0"
                                            Click="BtnAddFolder_Click" />
                                    <Button x:Name="BtnDelete" Content="{DynamicResource BtnDelete}" Click="BtnDelete_Click" />
                                </StackPanel>

                                <TreeView x:Name="ShortcutTree" Grid.Row="1" Margin="10,0,10,8"
                                          BorderThickness="1"
                                          SelectedItemChanged="ShortcutTree_SelectedItemChanged"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="ShortcutTree_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="ShortcutTree_PreviewMouseMove"
                                          DragOver="ShortcutTree_DragOver"
                                          DragLeave="ShortcutTree_DragLeave"
                                          Drop="ShortcutTree_Drop">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="AllowDrop" Value="True" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:ShortcutItemViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="📄"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Label}" FontSize="13" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>

                                <StatusBar Grid.Row="2">
                                    <TextBlock x:Name="StatusText" Text="{DynamicResource StatusReady}" Margin="6,2" />
                                </StatusBar>
                            </Grid>
                        </Border>

                        <!-- Item properties panel -->
                        <Border Grid.Column="2"
                                Background="{StaticResource Bg.Panel}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource PropHeader}" Style="{StaticResource SectionHeader}" />

                                    <TextBlock Text="{DynamicResource PropLabel}" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="PropLabel" Margin="0,0,0,12" TextChanged="PropChanged" />

                                    <TextBlock Text="{DynamicResource PropTargetPath}" Style="{StaticResource LabelText}" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PropTargetPath" Grid.Column="0"
                                                 Margin="0,0,6,0" TextChanged="PropChanged" />
                                        <Button x:Name="PropBrowse" Grid.Column="1" Content="{DynamicResource PropBrowse}"
                                                Padding="10,6" Click="PropBrowse_Click" />
                                    </Grid>

                                    <TextBlock Text="{DynamicResource PropArguments}" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="PropArguments" Margin="0,0,0,12" TextChanged="PropChanged" />

                                    <TextBlock Text="{DynamicResource PropWorkDir}" Style="{StaticResource LabelText}" />
                                    <TextBox x:Name="PropWorkDir" Margin="0,0,0,12" TextChanged="PropChanged" />

                                    <Separator />

                                    <CheckBox x:Name="PropIsFolder" IsEnabled="False" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource PropIsFolder}" Foreground="{StaticResource Text.Secondary}" />
                                    </CheckBox>
                                    <CheckBox x:Name="PropHasChildren" IsEnabled="False" Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource PropHasChildren}" Foreground="{StaticResource Text.Secondary}" />
                                    </CheckBox>
                                    <CheckBox x:Name="PropRunAsAdmin" Margin="0,0,0,6"
                                              Checked="PropRunAsAdmin_Changed" Unchecked="PropRunAsAdmin_Changed">
                                        <TextBlock Text="{DynamicResource PropRunAsAdmin}" Foreground="{StaticResource Text.Secondary}" />
                                    </CheckBox>

                                    <Separator />

                                    <Button x:Name="BtnSave" Content="{DynamicResource BtnSaveConfig}"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="14,10" Click="BtnSave_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource TabSettings}">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="16">
                        <!-- Two-column responsive layout via UniformGrid -->
                        <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                            <!-- ══ LEFT COLUMN ══════════════════════════════ -->
                            <StackPanel Margin="0,0,8,0">

                                <!-- Hotkey -->
                                <TextBlock Text="{DynamicResource SectionHotkey}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource HotkeyModifiers}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <CheckBox x:Name="SetCtrl" Margin="0,0,14,0"
                                                      Checked="SetModifier_Changed" Unchecked="SetModifier_Changed">Ctrl</CheckBox>
                                            <CheckBox x:Name="SetAlt" Margin="0,0,14,0"
                                                      Checked="SetModifier_Changed" Unchecked="SetModifier_Changed">Alt</CheckBox>
                                            <CheckBox x:Name="SetShift" Margin="0,0,14,0"
                                                      Checked="SetModifier_Changed" Unchecked="SetModifier_Changed">Shift</CheckBox>
                                            <CheckBox x:Name="SetWin"
                                                      Checked="SetModifier_Changed" Unchecked="SetModifier_Changed">Win</CheckBox>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource HotkeyKey}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <ComboBox x:Name="SetKey" Grid.Row="1" Grid.Column="1" Margin="0,6"
                                                  SelectionChanged="SetKey_SelectionChanged" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource HotkeyMouse}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <CheckBox x:Name="SetMouseEnabled" Grid.Row="2" Grid.Column="1" Margin="0,6"
                                                  Checked="SetMouseEnabled_Changed" Unchecked="SetMouseEnabled_Changed"><Run Text="{DynamicResource HotkeyMouseEnable}" /></CheckBox>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource HotkeyButton}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <ComboBox x:Name="SetMouseButton" Grid.Row="3" Grid.Column="1" Margin="0,6"
                                                  SelectionChanged="SetMouseButton_SelectionChanged" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource HotkeyHoldDelay}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <Slider x:Name="SetHoldDelay" Minimum="100" Maximum="1000"
                                                    MinWidth="120" HorizontalAlignment="Stretch"
                                                    TickFrequency="50" VerticalAlignment="Center"
                                                    ValueChanged="SetHoldDelay_Changed" />
                                            <TextBlock x:Name="SetHoldDelayLabel" Text="200ms" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Trim.Gold}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Appearance -->
                                <TextBlock Text="{DynamicResource SectionAppearance}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource AppearanceWheelRadius}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <Slider x:Name="SetWheelRadius" Minimum="160" Maximum="380"
                                                    MinWidth="120" HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="SetWheelRadius_Changed" />
                                            <TextBlock x:Name="SetWheelRadiusLabel" Text="280" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Trim.Gold}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource AppearanceOpacity}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <Slider x:Name="SetOpacity" Minimum="0.3" Maximum="1.0"
                                                    MinWidth="120" HorizontalAlignment="Stretch"
                                                    TickFrequency="0.05" VerticalAlignment="Center"
                                                    ValueChanged="SetOpacity_Changed" />
                                            <TextBlock x:Name="SetOpacityLabel" Text="0.95" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Trim.Gold}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource AppearanceAccentColor}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <TextBox x:Name="SetAccentColor" Grid.Row="2" Grid.Column="1" Margin="0,6"
                                                 TextChanged="SetAccentColor_Changed" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource AppearanceBgColor}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <TextBox x:Name="SetBgColor" Grid.Row="3" Grid.Column="1" Margin="0,6"
                                                 TextChanged="SetBgColor_Changed" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource AppearanceBgImage}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SetBgImagePath" Grid.Column="0" Margin="0,0,6,0"
                                                     TextChanged="SetBgImagePath_Changed" />
                                            <Button Grid.Column="1" Content="{DynamicResource PropBrowse}" Padding="8,6" Margin="0,0,6,0"
                                                    Click="BtnBrowseBgImage_Click" />
                                            <Button Grid.Column="2" Content="✕" Padding="8,6"
                                                    Click="BtnClearBgImage_Click" />
                                        </Grid>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource AppearanceBgImageOpacity}"
                                                   VerticalAlignment="Center" Margin="0,6"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
                                            <Slider x:Name="SetBgImageOpacity" Minimum="0" Maximum="1"
                                                    MinWidth="120" HorizontalAlignment="Stretch"
                                                    TickFrequency="0.05" VerticalAlignment="Center"
                                                    ValueChanged="SetBgImageOpacity_Changed" />
                                            <TextBlock x:Name="SetBgImageOpacityLabel" Text="0.40" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" Foreground="{StaticResource Trim.Gold}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>

                            <!-- ══ RIGHT COLUMN ═════════════════════════════ -->
                            <StackPanel Margin="8,0,0,0">

                                <!-- General -->
                                <TextBlock Text="{DynamicResource SectionGeneral}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <CheckBox x:Name="SetStartWithWindows" Margin="0,0,0,10"
                                                  Checked="SetStartWithWindows_Changed" Unchecked="SetStartWithWindows_Changed"><Run Text="{DynamicResource GeneralStartWithWindows}" /></CheckBox>
                                        <CheckBox x:Name="SetRunMinimized" Margin="0,0,0,10"><Run Text="{DynamicResource GeneralRunMinimized}" /></CheckBox>
                                        <CheckBox x:Name="SetCloseWheelAfterLaunch"
                                                  Checked="SetCloseWheelAfterLaunch_Changed" Unchecked="SetCloseWheelAfterLaunch_Changed"><Run Text="{DynamicResource GeneralCloseWheelAfterLaunch}" /></CheckBox>
                                    </StackPanel>
                                </Border>

                                <!-- Language -->
                                <TextBlock Text="{DynamicResource SectionLanguage}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <ComboBox x:Name="SetLanguage"
                                              SelectionChanged="SetLanguage_Changed" />
                                </Border>

                                <!-- Update -->
                                <TextBlock Text="{DynamicResource SectionUpdate}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <!-- Version info -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{DynamicResource UpdateCurrentVersion}"
                                                           Foreground="{StaticResource Text.Secondary}" FontSize="11" />
                                                <TextBlock x:Name="SetCurrentVersion"
                                                           Foreground="{StaticResource Trim.Gold}"
                                                           FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="BtnCheckUpdate" Grid.Column="1"
                                                    Content="{DynamicResource UpdateCheck}"
                                                    VerticalAlignment="Center"
                                                    Click="BtnCheckUpdate_Click" />
                                        </Grid>

                                        <Separator Margin="0,0,0,12" />

                                        <Border x:Name="UpdateNotice"
                                                Visibility="Collapsed"
                                                Background="#2F2617"
                                                BorderBrush="{StaticResource Trim.Gold}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="发现新版本 / Update available"
                                                           Foreground="{StaticResource Trim.Gold}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Margin="0,0,0,4" />
                                                <TextBlock x:Name="UpdateNoticeVersion"
                                                           Foreground="{StaticResource Text.Primary}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,10" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnUpdateView"
                                                            Content="查看 / View"
                                                            Padding="10,6"
                                                            Margin="0,0,8,0"
                                                            Click="BtnUpdateView_Click" />
                                                    <Button x:Name="BtnUpdateInstall"
                                                            Content="下载并安装 / Install"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="10,6"
                                                            Click="BtnUpdateInstall_Click" />
                                                </StackPanel>
                                                <ProgressBar x:Name="UpdateDownloadProgress"
                                                             Height="6"
                                                             Visibility="Collapsed"
                                                             Margin="0,10,0,0"
                                                             Foreground="{StaticResource Trim.Gold}"
                                                             Background="{StaticResource Bg.Input}" />
                                            </StackPanel>
                                        </Border>

                                        <CheckBox x:Name="SetAutoUpdate" Margin="0,0,0,8"
                                                  Checked="SetAutoUpdate_Changed" Unchecked="SetAutoUpdate_Changed"><Run Text="{DynamicResource UpdateAutoCheck}" /></CheckBox>

                                        <CheckBox x:Name="SetSilentUpdate" Margin="0,0,0,8"
                                                  Checked="SetSilentUpdate_Changed" Unchecked="SetSilentUpdate_Changed"><Run Text="{DynamicResource UpdateSilent}" /></CheckBox>

                                        <TextBlock x:Name="SetUpdateStatus"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- About -->
                                <TextBlock Text="{DynamicResource SectionAbout}" Style="{StaticResource SectionHeader}" />
                                <Border Background="{StaticResource Bg.Panel}"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="ShortcutWheel"
                                                   Foreground="{StaticResource Trim.Gold}"
                                                   FontWeight="Bold" FontSize="15" Margin="0,0,0,4" />
                                        <TextBlock Text="{DynamicResource AboutDescription}"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock Foreground="{StaticResource Text.Secondary}" FontSize="11">
                                            <Run Text="{DynamicResource AboutGitHub}" /><Hyperlink NavigateUri="https://github.com/Toukaiteio/shortcut-wheel"
                                                     RequestNavigate="Hyperlink_RequestNavigate"
                                                     Foreground="{StaticResource Trim.GoldDim}">
                                                Toukaiteio/shortcut-wheel
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        </Grid>
    </Border>
</Window>


