<Window x:Class="ShortcutWheel.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShortcutWheel.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Normal"
        IsHitTestVisible="True"
        Focusable="True"
        Width="620" Height="620"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Grid x:Name="LayoutRoot" AllowDrop="True"
          DragEnter="LayoutRoot_DragEnter"
          DragOver="LayoutRoot_DragOver"
          DragLeave="LayoutRoot_DragLeave"
          Drop="LayoutRoot_Drop">
        <controls:RadialMenu x:Name="RadialMenuControl"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
    </Grid>
</Window>
