<Window x:Class="ShortcutWheel.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ShortcutWheel.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Normal"
        IsHitTestVisible="True"
        Focusable="True"
        Width="620" Height="620"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Grid x:Name="LayoutRoot" AllowDrop="True"
          DragEnter="LayoutRoot_DragEnter"
          DragOver="LayoutRoot_DragOver"
          DragLeave="LayoutRoot_DragLeave"
          Drop="LayoutRoot_Drop">
        <!-- Background image: Ellipse with ImageBrush fill — geometric circle, no clip needed -->
        <Ellipse x:Name="BgEllipse"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Visibility="Collapsed"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" />
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="BgEllipseScale" ScaleX="0" ScaleY="0" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <controls:RadialMenu x:Name="RadialMenuControl"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
    </Grid>
</Window>
